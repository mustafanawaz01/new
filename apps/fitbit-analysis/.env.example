# From https://dev.fitbit.com/apps → your app → OAuth 2.0 Client ID
FITBIT_CLIENT_ID=

# Must match exactly what you registered (see docs/PHASE-0-DEVELOPER-REGISTRATION.md)
FITBIT_REDIRECT_URI=http://127.0.0.1:3030/callback

# Only required for Server application type (not used by default PKCE Personal flow)
# FITBIT_CLIENT_SECRET=

# Space-separated scopes (do not enable more than you need in production)
FITBIT_SCOPES=profile oxygen_saturation heartrate sleep respiratory_rate temperature activity

# Local callback server port
FITBIT_AUTH_PORT=3030

# Date for spike script (yyyy-MM-dd or "today")
FITBIT_SPIKE_DATE=today
